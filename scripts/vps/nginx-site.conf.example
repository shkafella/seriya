# Public catalog. Replace <domain> and <project>.
server {
    listen 80;
    server_name <domain>;
    root /opt/<project>/current/website/dist;
    index index.html;
    client_max_body_size 10m;

    location / { try_files $uri $uri/ =404; }
    location /api/ {
        proxy_pass http://127.0.0.1:<backend-port>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Owner workspace. Use a protected subdomain such as admin.<domain>.
server {
    listen 80;
    server_name <app-domain>;
    root /opt/<project>/current/webapp/dist;
    index index.html;

    location / { try_files $uri /index.html; }
    location /api/ {
        proxy_pass http://127.0.0.1:<backend-port>;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
