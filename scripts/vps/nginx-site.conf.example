# nginx site for the webapp + API proxy. Install as
# /etc/nginx/sites-available/<domain>, symlink into sites-enabled, remove the
# stock "default" site, replace <domain> and <project>, then run
# `nginx -t && systemctl reload nginx`. Certbot upgrades this block to HTTPS
# and adds the HTTP->HTTPS redirect itself.
server {
    listen 80;
    server_name <domain>;

    root /opt/<project>/webapp/dist;
    index index.html;
    client_max_body_size 10m;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
