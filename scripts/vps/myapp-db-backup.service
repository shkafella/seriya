# Nightly database backup. Install with the matching .timer file; replace
# "myapp" with the project folder name under /opt.
[Unit]
Description=myapp: nightly PostgreSQL backup

[Service]
Type=oneshot
EnvironmentFile=/opt/myapp/shared/backend.env
Environment=PROJECT_ROOT=/opt/myapp/source
Environment=BACKUP_PROJECT_NAME=myapp
ExecStart=/bin/bash /opt/myapp/source/scripts/vps/db-backup.sh
