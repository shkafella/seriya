# Backend API as a systemd service. Install as
# /etc/systemd/system/<project>-backend.service and replace "myapp" with the
# project folder name under /opt. Bun auto-loads backend/.env from the
# working directory.
[Unit]
Description=myapp backend API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/myapp/backend
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
