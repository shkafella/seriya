# Install as /etc/systemd/system/<project>-backend.service and replace myapp.
[Unit]
Description=myapp backend API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/myapp/current/backend
EnvironmentFile=/opt/myapp/shared/backend.env
ExecStart=/root/.bun/bin/bun run start:raw
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
