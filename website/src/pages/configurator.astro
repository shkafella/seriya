  .row-picker { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 4px; } .row-picker button { flex: 0 0 auto; } .row-picker .is-active { color: white; border-color: #274b33; background: #274b33; }
  .module-properties { display: grid; gap: 10px; margin-top: -10px; padding: 14px; border: 1px solid #b9c9b9; border-radius: 0 0 16px 16px; background: #fff; } .module-properties > div:first-child { display: grid; gap: 2px; } .module-properties > div:first-child span { color: #66716a; font-size: .78rem; } .property-actions { display: flex; flex-wrap: wrap; gap: 7px; } .cut-control { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 7px; font-size: .78rem; font-weight: 750; } .cut-control input { min-width: 0; }
