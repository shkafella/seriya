  .draft-notice[hidden] { display: none; }
  .draft-actions, .history-toolbar { display: flex; flex-wrap: wrap; gap: 8px; }
  .history-toolbar { justify-content: flex-end; margin: 14px 0 -6px; }
  .history-toolbar button:disabled { opacity: .45; cursor: not-allowed; }
  .config-toolbar, .trim-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 20px 0; padding: 12px; border: 1px solid #ddd6c8; border-radius: 16px; background: #fff; }
  .config-toolbar label, .trim-options label { display: grid; gap: 5px; color: #4d5b51; font-size: .75rem; font-weight: 750; }
  .config-toolbar .toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; font-size: .86rem; }
  .config-toolbar .toggle input { min-height: 18px; width: 18px; }
  .scene-card { overflow: hidden; margin: 20px 0; border: 1px solid #d5ddcf; border-radius: 20px; background: #f7faf4; }
  .scene-status { display: flex; justify-content: space-between; gap: 12px; padding: 12px 14px; color: #536357; font-size: .78rem; background: #e6ede2; }
  .kitchen-scene { display: grid; gap: 5px; min-height: 245px; padding: 16px 10px; overflow: hidden; }
  .scene-row { display: grid; grid-template-columns: 60px minmax(0, 1fr); gap: 6px; align-items: center; min-width: 0; }
  .scene-row > strong { color: #5d6a60; font-size: .7rem; }
  .scene-modules { display: flex; min-width: 0; min-height: 62px; gap: 2px; align-items: stretch; overflow: hidden; }
  .scene-modules.from-right { flex-direction: row-reverse; }
  .scene-gap { flex: var(--span) 1 0; min-width: 0; background: repeating-linear-gradient(135deg, transparent, transparent 5px, rgba(111, 126, 112, .16) 5px, rgba(111, 126, 112, .16) 7px); }
  .free-intervals { display: flex; flex-wrap: wrap; gap: 7px; margin: -8px 0 16px; } .free-intervals button { min-height: 36px; padding: 6px 9px; border-style: dashed; font-size: .75rem; } .free-intervals .is-selected { color: white; border-style: solid; border-color: #274b33; background: #274b33; }
  .scene-module { flex: var(--span) 1 0; min-width: 0; display: grid; align-content: center; gap: 2px; min-height: 62px; padding: 4px; overflow: hidden; color: #26392b; border: 1px solid #78927a; border-radius: 5px; background: #d8e7d6; font-size: .61rem; text-align: left; }
  .scene-wall .scene-module { background: #ece5cf; border-color: #a99052; } .scene-mezzanine .scene-module { background: #dce2eb; border-color: #8091a7; }
  .scene-module.without-facade { background: repeating-linear-gradient(45deg, #f4f1e9, #f4f1e9 5px, #ded8cb 5px, #ded8cb 10px); }
  .scene-module.is-selected { outline: 3px solid #244f39; outline-offset: 1px; } .scene-module.false-panel { flex: 16 0 0; min-width: 26px; background: #cdd4c5; border-color: #6d7965; }
  .scene-module span, .scene-module small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .scene-module small { color: #546054; } .scene-empty { padding: 18px; color: #829085; border: 1px dashed #b3c0b2; border-radius: 6px; }
  .row-picker { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 4px; } .row-picker button { flex: 0 0 auto; } .row-picker .is-active { color: white; border-color: #274b33; background: #274b33; }
  .module-properties { display: grid; gap: 10px; margin-top: -10px; padding: 14px; border: 1px solid #b9c9b9; border-radius: 0 0 16px 16px; background: #fff; } .module-properties > div:first-child { display: grid; gap: 2px; } .module-properties > div:first-child span { color: #66716a; font-size: .78rem; } .property-actions { display: flex; flex-wrap: wrap; gap: 7px; } .cut-control { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 7px; font-size: .78rem; font-weight: 750; } .cut-control input { min-width: 0; }
  .module-sheet { margin-top: 14px; padding: 14px; border-radius: 18px 18px 0 0; background: #e8ede4; } .sheet-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; } .sheet-heading div { display: grid; gap: 3px; } .sheet-heading span { color: #617065; font-size: .75rem; } .sheet-actions { display: flex; flex-wrap: wrap; gap: 6px; } .replace-mode { display: flex; align-items: center; gap: 7px; margin-top: 12px; color: #526055; font-size: .78rem; font-weight: 700; } .replace-mode input { min-height: 18px; width: 18px; }
  .module-catalog { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; max-height: 280px; overflow: auto; } .module-catalog button { display: grid; min-height: 74px; gap: 3px; padding: 9px; text-align: left; } .module-catalog button span { color: #637067; font-size: .72rem; }
  .quote-card { position: sticky; bottom: 0; z-index: 3; display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; padding: 16px; border-radius: 16px; color: white; background: #254731; box-shadow: 0 -8px 28px rgba(23, 46, 31, .18); } .quote-card > div { display: grid; gap: 3px; } .quote-caption, #quote-status, #quote-vat { color: #d8e5da; font-size: .75rem; } #quote-total { font-size: 1.35rem; } #quote-status { max-width: 42%; text-align: right; align-self: center; }
  .specification { margin-top: 12px; padding: 14px; border: 1px solid #ddd6c8; border-radius: 14px; background: #fff; } .specification summary { cursor: pointer; font-weight: 800; } #specification-lines { display: grid; gap: 8px; margin-top: 12px; } .spec-line { display: flex; justify-content: space-between; gap: 10px; color: #445247; font-size: .82rem; } .spec-line.customer-supplied { color: #8a6833; }
  @media (min-width: 720px) { .config-toolbar { grid-template-columns: repeat(3, minmax(0, 1fr)); } .module-catalog { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
