  .specification { margin-top: 12px; padding: 14px; border: 1px solid #ddd6c8; border-radius: 14px; background: #fff; } .specification summary { cursor: pointer; font-weight: 800; } #specification-lines { display: grid; gap: 8px; margin-top: 12px; } .spec-line { display: flex; justify-content: space-between; gap: 10px; color: #445247; font-size: .82rem; } .spec-line.customer-supplied { color: #8a6833; }
  @media (min-width: 720px) { .config-toolbar { grid-template-columns: repeat(3, minmax(0, 1fr)); } .module-catalog { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
