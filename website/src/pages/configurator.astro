  .free-intervals { display: flex; flex-wrap: wrap; gap: 7px; margin: -8px 0 16px; } .free-intervals button { min-height: 36px; padding: 6px 9px; border-style: dashed; font-size: .75rem; } .free-intervals .is-selected { color: white; border-style: solid; border-color: #274b33; background: #274b33; }
  .scene-module { flex: var(--span) 1 0; min-width: 0; display: grid; align-content: center; gap: 2px; min-height: 62px; padding: 4px; overflow: hidden; color: #26392b; border: 1px solid #78927a; border-radius: 5px; background: #d8e7d6; font-size: .61rem; text-align: left; }
  .scene-wall .scene-module { background: #ece5cf; border-color: #a99052; } .scene-mezzanine .scene-module { background: #dce2eb; border-color: #8091a7; }
  .scene-module.without-facade { background: repeating-linear-gradient(45deg, #f4f1e9, #f4f1e9 5px, #ded8cb 5px, #ded8cb 10px); }
  .scene-module.is-selected { outline: 3px solid #244f39; outline-offset: 1px; } .scene-module.false-panel { flex: 16 0 0; min-width: 26px; background: #cdd4c5; border-color: #6d7965; }
  .scene-module span, .scene-module small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .scene-module small { color: #546054; } .scene-empty { padding: 18px; color: #829085; border: 1px dashed #b3c0b2; border-radius: 6px; }
  .row-picker { display: flex; gap: 7px; overflow-x: auto; padding-bottom: 4px; } .row-picker button { flex: 0 0 auto; } .row-picker .is-active { color: white; border-color: #274b33; background: #274b33; }
  .module-properties { display: grid; gap: 10px; margin-top: -10px; padding: 14px; border: 1px solid #b9c9b9; border-radius: 0 0 16px 16px; background: #fff; } .module-properties > div:first-child { display: grid; gap: 2px; } .module-properties > div:first-child span { color: #66716a; font-size: .78rem; } .property-actions { display: flex; flex-wrap: wrap; gap: 7px; } .cut-control { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 7px; font-size: .78rem; font-weight: 750; } .cut-control input { min-width: 0; }
  .module-sheet { margin-top: 14px; padding: 14px; border-radius: 18px 18px 0 0; background: #e8ede4; } .sheet-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; } .sheet-heading div { display: grid; gap: 3px; } .sheet-heading span { color: #617065; font-size: .75rem; } .sheet-actions { display: flex; flex-wrap: wrap; gap: 6px; } .replace-mode { display: flex; align-items: center; gap: 7px; margin-top: 12px; color: #526055; font-size: .78rem; font-weight: 700; } .replace-mode input { min-height: 18px; width: 18px; }
