---
import CatalogLayout from '../layouts/CatalogLayout.astro'

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? '/api'
---

<CatalogLayout title="Конфигуратор прямой кухни — Серийка" description="Соберите прямую кухню из серийных модулей и получите точную цену." releaseId="live-configurator">
  <main class="configurator" data-api-base={apiBase}>
    <p class="eyebrow">Конфигуратор кухни</p>
    <h1>Соберите прямую кухню</h1>
    <p class="lede">Выберите модули — цена и спецификация считаются на сервере. Столешница показана условно и в стоимость не входит.</p>

    <div id="config-error" class="config-message" role="alert" hidden></div>
    <div id="config-loading" class="config-message">Загружаем опубликованный каталог…</div>
    <section id="draft-notice" class="config-message draft-notice" aria-live="polite" hidden>
      <span id="draft-notice-text"></span>
      <div class="draft-actions">
        <button id="restore-draft" type="button">Восстановить</button>
        <button id="discard-draft" type="button">Удалить черновик</button>
      </div>
    </section>

    <section id="reconciliation-card" class="reconciliation-card" aria-live="polite" hidden>
      <p class="eyebrow">Обновление сохранённой кухни</p>
      <h2>Проверьте изменения каталога</h2>
      <p id="reconciliation-status">Сверяем сохранённую кухню с текущим каталогом…</p>
      <div id="reconciliation-prices" class="reconciliation-prices" hidden></div>
      <div id="reconciliation-issues" class="reconciliation-issues"></div>
      <div class="draft-actions">
        <button id="reconciliation-retry" type="button" hidden>Повторить</button>
        <button id="reconciliation-accept" type="button" hidden>Принять текущую цену</button>
        <button id="reconciliation-discard" type="button">Удалить черновик</button>
      </div>
    </section>

    <section id="config-app" hidden>
      <div class="history-toolbar" aria-label="История изменений">
        <button id="undo-change" type="button" disabled aria-label="Отменить последнее изменение">↶ Отменить</button>
        <button id="redo-change" type="button" disabled aria-label="Вернуть отменённое изменение">↷ Вернуть</button>
      </div>
      <div class="config-toolbar" aria-label="Параметры кухни">
        <label>Длина стены, мм <input id="wall-length" inputmode="numeric" min="1" placeholder="Необязательно" /></label>
        <label>Начинать от <select id="start-side"><option value="left">левой стены</option><option value="right">правой стены</option></select></label>
        <label>Корпус <select id="body-material"></select></label>
        <label>Фасад <select id="facade-material"></select></label>
        <label class="toggle"><input id="facades-enabled" type="checkbox" checked /> Фасады нужны</label>
        <label class="toggle"><input id="packaging-enabled" type="checkbox" /> Упаковка</label>
        <label>Столешница <select id="countertop"><option value="38">38 мм</option><option value="20">20 мм</option><option value="12">12 мм</option></select></label>
      </div>

      <section class="scene-card" aria-label="Фронтальный вид кухни">
        <div class="scene-status"><strong id="scene-height">Высота кухни: —</strong><span id="scene-length">Занятая длина: —</span></div>
        <div id="kitchen-scene" class="kitchen-scene"></div>
      </section>
      <section id="free-intervals" class="free-intervals" aria-label="Свободные интервалы ряда" hidden></section>
      <section id="module-properties" class="module-properties" aria-live="polite" hidden></section>

      <section class="row-picker" aria-label="Ряд модулей">
        <button type="button" data-row="lower" class="is-active">Нижний ряд</button>
        <button type="button" data-row="wall">Средний ряд</button>
        <button type="button" data-row="mezzanine">Антресоль</button>
      </section>

      <section class="module-sheet" aria-label="Модули выбранного ряда">
        <div class="sheet-heading"><div><strong id="active-row-title">Нижний ряд</strong><span>Нажмите модуль, чтобы добавить его в конец ряда</span></div><div class="sheet-actions"><button id="suggest-upper" type="button" hidden>Предложить верх</button><label>Фальш‑панель <select id="false-panel-position"><option value="start">в начале</option><option value="between">между модулями</option><option value="end" selected>в конце</option></select></label><button id="add-false-panel" type="button">Добавить</button></div></div>
        <label class="replace-mode"><input id="replace-mode" type="checkbox" /> Заменять выбранный модуль вместо добавления</label>
        <div id="module-catalog" class="module-catalog"></div>
      </section>

      <section class="trim-options" aria-label="Доборные элементы">
        <label>Цоколь <select id="plinth-select"><option value="">Не добавлять</option></select></label>
        <label>Корона <select id="crown-select"><option value="">Не добавлять</option></select></label>
      </section>

      <section class="quote-card" aria-live="polite">
        <div><span class="quote-caption">Точная цена кухни</span><strong id="quote-total">Добавьте модуль</strong><span id="quote-vat"></span></div>
        <div class="quote-actions"><span id="quote-status">Цена появится после выбора модуля.</span><button id="accept-quote" type="button" hidden>Принять цену</button></div>
      </section>
      <details class="specification"><summary>Спецификация</summary><div id="specification-lines">Пока нет позиций.</div></details>
    </section>
  </main>
</CatalogLayout>

<script>
  import type {
    AcceptedConfigurationQuote,
    ConfigurationBootstrap,
    ConfigurationQuoteRequest,
    ConfigurationQuoteResponse,
    ConfiguratorDraft,
    ConfiguratorReconciliationResponse,
    ReconciliationIssue,
  } from '@seriya/contracts'
  import { acceptanceMatchesQuote, acceptedQuoteFromResponse } from '../features/configurator/acceptance'
  import { validateDraftCompatibility } from '../features/configurator/draft-compatibility'
  import {
    CONFIGURATOR_DRAFT_STORAGE_KEY,
    readConfiguratorDraft,
    serializeConfiguratorDraft,
  } from '../features/configurator/draft-storage'
  import {
    currentRowEnd,
    falsePanelFitsWall,
    freeIntervalsForRow,
    moduleFitsWall,
    normalizeFalsePanels,
    occupiedRowEnd,
    reflowConfiguratorRow,
    variantSpan,
  } from '../features/configurator/layout'
  import {
    buildConfigurationCommand,
    configuratorRows,
    ConfiguratorStateModel,
    configuratorStateFromDraft,
    createInitialConfiguratorState,
    type ConfiguratorFalsePanel,
    type ConfiguratorRow,
    type ConfiguratorState,
  } from '../features/configurator/state'

  type Row = ConfiguratorRow
  type FalsePanel = ConfiguratorFalsePanel
  type Variant = ConfigurationBootstrap['variants'][number]
  type Bootstrap = ConfigurationBootstrap

  const root = document.querySelector<HTMLElement>('.configurator')
  const apiBase = root?.dataset.apiBase ?? '/api'
  const loading = document.querySelector<HTMLElement>('#config-loading')
  const app = document.querySelector<HTMLElement>('#config-app')
  const error = document.querySelector<HTMLElement>('#config-error')
  const scene = document.querySelector<HTMLElement>('#kitchen-scene')
  const catalog = document.querySelector<HTMLElement>('#module-catalog')
  const activeTitle = document.querySelector<HTMLElement>('#active-row-title')
  const quoteTotal = document.querySelector<HTMLElement>('#quote-total')
  const quoteVat = document.querySelector<HTMLElement>('#quote-vat')
  const quoteStatus = document.querySelector<HTMLElement>('#quote-status')
  const specification = document.querySelector<HTMLElement>('#specification-lines')
  const height = document.querySelector<HTMLElement>('#scene-height')
  const length = document.querySelector<HTMLElement>('#scene-length')
  const bodySelect = document.querySelector<HTMLSelectElement>('#body-material')
  const facadeSelect = document.querySelector<HTMLSelectElement>('#facade-material')
  const facadesEnabled = document.querySelector<HTMLInputElement>('#facades-enabled')
  const packagingEnabled = document.querySelector<HTMLInputElement>('#packaging-enabled')
  const countertop = document.querySelector<HTMLSelectElement>('#countertop')
  const wallLength = document.querySelector<HTMLInputElement>('#wall-length')
  const startSide = document.querySelector<HTMLSelectElement>('#start-side')
  const plinthSelect = document.querySelector<HTMLSelectElement>('#plinth-select')
  const crownSelect = document.querySelector<HTMLSelectElement>('#crown-select')
  const properties = document.querySelector<HTMLElement>('#module-properties')
  const replaceMode = document.querySelector<HTMLInputElement>('#replace-mode')
  const suggestUpperButton = document.querySelector<HTMLButtonElement>('#suggest-upper')
  const falsePanelPosition = document.querySelector<HTMLSelectElement>('#false-panel-position')
  const freeIntervalsHost = document.querySelector<HTMLElement>('#free-intervals')
  const draftNotice = document.querySelector<HTMLElement>('#draft-notice')
  const draftNoticeText = document.querySelector<HTMLElement>('#draft-notice-text')
  const restoreDraftButton = document.querySelector<HTMLButtonElement>('#restore-draft')
  const discardDraftButton = document.querySelector<HTMLButtonElement>('#discard-draft')
  const undoButton = document.querySelector<HTMLButtonElement>('#undo-change')
  const redoButton = document.querySelector<HTMLButtonElement>('#redo-change')
  const acceptQuoteButton = document.querySelector<HTMLButtonElement>('#accept-quote')
  const reconciliationCard = document.querySelector<HTMLElement>('#reconciliation-card')
  const reconciliationStatus = document.querySelector<HTMLElement>('#reconciliation-status')
  const reconciliationPrices = document.querySelector<HTMLElement>('#reconciliation-prices')
  const reconciliationIssues = document.querySelector<HTMLElement>('#reconciliation-issues')
  const reconciliationRetryButton = document.querySelector<HTMLButtonElement>('#reconciliation-retry')
  const reconciliationAcceptButton = document.querySelector<HTMLButtonElement>('#reconciliation-accept')
  const reconciliationDiscardButton = document.querySelector<HTMLButtonElement>('#reconciliation-discard')
  const rows = configuratorRows
  const rowNames: Record<Row, string> = { lower: 'Нижний ряд', wall: 'Средний ряд', mezzanine: 'Антресоль' }
  const rubles = new Intl.NumberFormat('ru-RU')

  let bootstrap: Bootstrap | null = null
  let activeRow: Row = 'lower'
  let selected: { row: Row; index: number } | null = null
  let selectedInterval: { row: Row; startMm: number; endMm: number } | null = null
  let quotedFreeIntervals: Array<{ row: Row; startMm: number; endMm: number }> | null = null
  let quoteAbort: AbortController | null = null
  let intent = 0
  let saveTimer: ReturnType<typeof setTimeout> | null = null
  let pendingDraft: ConfiguratorDraft | null = null
  let draftWriteBlocked = false
  let latestQuote: ConfigurationQuoteResponse | null = null
  let activeReconciliation: {
    sourceCommand: ConfigurationQuoteRequest
    workingCommand: ConfigurationQuoteRequest
    startSide: 'left' | 'right'
    response: ConfiguratorReconciliationResponse | null
    reloadRequired: boolean
    requestPending: boolean
    requestRevision: number
    requestAbort: AbortController | null
  } | null = null
  const stateModel = new ConfiguratorStateModel()
  let state = stateModel.state

  function escape(value: string) { return value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char] ?? char) }
  function span(variant: Variant) { return variantSpan(variant) }
  function currentEnd(row: Row) { return currentRowEnd(state, requiredBootstrap(), row) }
  function rowEnd(row: Row) { return occupiedRowEnd(state, requiredBootstrap(), row) }
  function wallMm() {
    return state.wallLengthMm
  }
  function fitsWall(row: Row, nextModuleSpan = 0, replacedIndex: number | null = null) {
    return moduleFitsWall(state, requiredBootstrap(), row, nextModuleSpan, replacedIndex)
  }
  function fitsFalsePanel(row: Row, nextPanelSpan: number, position: FalsePanel['position'], anchorIndex?: number) {
    return falsePanelFitsWall(state, requiredBootstrap(), row, nextPanelSpan, position, anchorIndex)
  }
  function intervalsForRow(row: Row) {
    return freeIntervalsForRow(state, requiredBootstrap(), row)
  }
  function isFreeInterval(interval: { row: Row; startMm: number; endMm: number }) {
    return intervalsForRow(interval.row).some((item) => item.startMm === interval.startMm && item.endMm === interval.endMm)
  }
  function renderFreeIntervals() {
    if (!freeIntervalsHost) return
    const intervals = (quotedFreeIntervals ?? intervalsForRow(activeRow)).filter((item) => item.row === activeRow && isFreeInterval(item))
    if (selectedInterval && !intervals.some((item) => item.startMm === selectedInterval!.startMm && item.endMm === selectedInterval!.endMm)) selectedInterval = null
    freeIntervalsHost.hidden = intervals.length === 0
    freeIntervalsHost.innerHTML = intervals.map((item) => `<button type="button" class="${selectedInterval?.row === item.row && selectedInterval.startMm === item.startMm ? 'is-selected' : ''}" data-interval-start="${item.startMm}" data-interval-end="${item.endMm}">Свободно ${item.endMm - item.startMm} мм</button>`).join('')
    freeIntervalsHost.querySelectorAll<HTMLButtonElement>('[data-interval-start]').forEach((button) => button.addEventListener('click', () => {
      selectedInterval = { row: activeRow, startMm: Number(button.dataset.intervalStart), endMm: Number(button.dataset.intervalEnd) }
      render()
    }))
  }
  function showLocalMessage(message: string) { if (quoteStatus) quoteStatus.textContent = message }
  function renderWallStatus(spans?: Record<Row, number>) {
    if (!length) return
    const occupied = Math.max(...(spans ? rows.map((row) => spans[row]) : rows.map(rowEnd)))
    const wall = wallMm()
    const side = state.startSide === 'right' ? 'от правой стены' : 'от левой стены'
    if (wall === null) { length.textContent = `Занято: ${occupied} мм · ${side}`; return }
    const difference = wall - occupied
    length.textContent = difference >= 0
      ? `Занято: ${occupied} из ${wall} мм · свободно ${difference} мм · ${side}`
      : `Занято: ${occupied} из ${wall} мм · выходит на ${Math.abs(difference)} мм · ${side}`
  }
  function requiredBootstrap() { if (!bootstrap) throw new Error('Конфигуратор ещё не готов'); return bootstrap }
  function findVariant(id: string) { const variant = bootstrap?.variants.find((item) => item.id === id); if (!variant) throw new Error('Модуль больше недоступен'); return variant }
  function options(items: Bootstrap['materials']) { return items.map((item) => `<option value="${escape(item.id)}">${escape(item.name)}</option>`).join('') }

  function updateHistoryButtons() {
    if (undoButton) undoButton.disabled = !stateModel.canUndo
    if (redoButton) redoButton.disabled = !stateModel.canRedo
  }

  function syncControlsFromState() {
    if (wallLength) wallLength.value = state.wallLengthMm === null ? '' : String(state.wallLengthMm)
    if (startSide) startSide.value = state.startSide
    if (bodySelect) bodySelect.value = state.bodyMaterialId
    if (facadeSelect) facadeSelect.value = state.facadeMaterialId ?? ''
    if (facadesEnabled) facadesEnabled.checked = state.facadesIncluded
    if (packagingEnabled) packagingEnabled.checked = state.packagingIncluded
    if (countertop) countertop.value = String(state.countertopThicknessMm)
    if (plinthSelect) plinthSelect.value = state.plinthVariantId ?? ''
    if (crownSelect) crownSelect.value = state.crownVariantId ?? ''
    updateHistoryButtons()
  }

  function syncWallLengthFromControl() {
    if (!wallLength) return false
    const value = Number(wallLength.value)
    const nextWallLength = Number.isInteger(value) && value > 0 ? value : null
    const changed = stateModel.mutate((nextState) => { nextState.wallLengthMm = nextWallLength })
    state = stateModel.state
    if (!changed) return false
    updateHistoryButtons()
    return true
  }

  function scheduleDraftSave() {
    if (saveTimer) clearTimeout(saveTimer)
    saveTimer = setTimeout(flushDraft, 350)
  }

  function flushDraft() {
    if (saveTimer) clearTimeout(saveTimer)
    saveTimer = null
    if (draftWriteBlocked) return
    syncWallLengthFromControl()
    const command = buildConfigurationCommand(state, 'local-draft')
    try {
      if (!command) localStorage.removeItem(CONFIGURATOR_DRAFT_STORAGE_KEY)
      else localStorage.setItem(
        CONFIGURATOR_DRAFT_STORAGE_KEY,
        serializeConfiguratorDraft(command, stateModel.acceptedQuote, { startSide: state.startSide }),
      )
    } catch {
      showLocalMessage('Браузер не смог сохранить черновик. Не закрывайте страницу.')
    }
  }

  function commitStateMutation(mutator: () => void) {
    const previousState = state
    try {
      const changed = stateModel.mutate((nextState) => {
        state = nextState
        mutator()
      })
      state = stateModel.state
      if (changed) scheduleDraftSave()
      updateHistoryButtons()
    } catch (caught) {
      state = previousState
      throw caught
    }
  }

  function restoreHistory(nextState: ConfiguratorState, restoredAcceptedQuote: AcceptedConfigurationQuote | null = null) {
    stateModel.restore(nextState, restoredAcceptedQuote)
    state = stateModel.state
    selected = null
    selectedInterval = null
    scheduleDraftSave()
    render()
  }

  function undo() {
    if (!stateModel.undo()) return
    state = stateModel.state
    selected = null
    selectedInterval = null
    scheduleDraftSave()
    render()
  }

  function redo() {
    if (!stateModel.redo()) return
    state = stateModel.state
    selected = null
    selectedInterval = null
    scheduleDraftSave()
    render()
  }

  function hideDraftNotice() {
    pendingDraft = null
    draftWriteBlocked = false
    app?.removeAttribute('inert')
    app?.removeAttribute('aria-disabled')
    draftNotice?.setAttribute('hidden', '')
  }

  function showDraftNotice(message: string, draft: ConfiguratorDraft | null, canRestore: boolean, blockEditing = true) {
    pendingDraft = draft
    draftWriteBlocked = blockEditing
    if (blockEditing) {
      app?.setAttribute('inert', '')
      app?.setAttribute('aria-disabled', 'true')
    } else {
      app?.removeAttribute('inert')
      app?.removeAttribute('aria-disabled')
    }
    if (draftNoticeText) {
      draftNoticeText.textContent = blockEditing
        ? `${message} Чтобы продолжить редактирование, восстановите или удалите этот черновик.`
        : message
    }
    if (restoreDraftButton) restoreDraftButton.hidden = !canRestore
    draftNotice?.removeAttribute('hidden')
  }

  function saveReconciliationDraft() {
    if (!activeReconciliation) return false
    try {
      localStorage.setItem(CONFIGURATOR_DRAFT_STORAGE_KEY, serializeConfiguratorDraft(
        activeReconciliation.workingCommand,
        null,
        { startSide: activeReconciliation.startSide },
        new Date(),
        activeReconciliation.sourceCommand,
      ))
      return true
    } catch {
      return false
    }
  }

  function setReconciliationControlsDisabled(disabled: boolean) {
    reconciliationIssues?.querySelectorAll<HTMLButtonElement | HTMLSelectElement>('button, select')
      .forEach((control) => { control.disabled = disabled })
  }

  function closeReconciliation() {
    activeReconciliation?.requestAbort?.abort()
    activeReconciliation = null
    reconciliationCard?.setAttribute('hidden', '')
    if (reconciliationIssues) reconciliationIssues.innerHTML = ''
    app?.removeAttribute('inert')
    app?.removeAttribute('aria-disabled')
  }

  function abandonReconciliationForEmptyKitchen() {
    if (!bootstrap) return
    localStorage.removeItem(CONFIGURATOR_DRAFT_STORAGE_KEY)
    closeReconciliation()
    hideDraftNotice()
    stateModel.restore(createInitialConfiguratorState(bootstrap))
    state = stateModel.state
    app?.removeAttribute('hidden')
    render()
    showLocalMessage('Сохранённая кухня удалена. Добавьте новый модуль, чтобы получить цену.')
  }

  function reconciliationTargetLabel(issue: Extract<ReconciliationIssue, { blocking: true }>) {
    if (issue.target.kind === 'module') return `${rowNames[issue.target.row]}, позиция ${issue.target.index + 1}`
    if (issue.target.kind === 'false_panel') return `Фальш-панель ${issue.target.index + 1}`
    if (issue.target.kind === 'material') return issue.target.field === 'bodyMaterialId' ? 'Материал корпуса' : 'Материал фасада'
    return issue.target.field === 'plinthVariantId' ? 'Цоколь' : 'Корона'
  }

  function dependentPanelIndexes(
    issue: Extract<ReconciliationIssue, { blocking: true }>,
    response: ConfiguratorReconciliationResponse,
  ) {
    const target = issue.target
    if (target.kind !== 'module') return []
    const row = response.workingCommand.rows.find((item) => item.row === target.row)
    if (!row?.modules[target.index]) return []
    const moduleIntervals = row.modules.flatMap((module, index) => {
      if (index === target.index) return []
      const originalIssue = response.issues.find((candidate) => candidate.blocking
        && candidate.target.kind === 'module'
        && candidate.target.row === target.row
        && candidate.target.index === index)
      const originalSpan = originalIssue?.blocking && originalIssue.originalSelection.kind === 'variant'
        ? originalIssue.originalSelection.layoutSpanMm ?? originalIssue.originalSelection.widthMm
        : null
      const currentVariant = bootstrap?.variants.find((variant) => variant.id === module.variantId)
      const moduleSpan = module.cutWidthMm ?? originalSpan
        ?? (currentVariant ? span(currentVariant) : null)
      return moduleSpan === null ? [] : [{ start: module.startMm, end: module.startMm + moduleSpan }]
    })
    if (moduleIntervals.length !== row.modules.length - 1) return []
    const panels = response.workingCommand.falsePanels
    return panels.flatMap((panel, panelIndex) => {
      if (panel.row !== target.row) return []
      const hasOwnIssue = response.issues.some((candidate) => candidate.blocking
        && candidate.target.kind === 'false_panel'
        && candidate.target.index === panelIndex)
      if (hasOwnIssue) return []
      const rowItems = [
        ...moduleIntervals,
        ...panels.flatMap((other, otherIndex) => otherIndex === panelIndex || other.row !== panel.row
          ? []
          : [{ start: other.startMm, end: other.startMm + other.widthMm }]),
      ]
      if (rowItems.length === 0) return []
      const start = Math.min(...rowItems.map((item) => item.start))
      const end = Math.max(...rowItems.map((item) => item.end))
      const wouldBeInvalid = (panel.position === 'start' && panel.startMm > start)
        || (panel.position === 'end' && panel.startMm < end)
        || (panel.position === 'between' && (panel.startMm <= start || panel.startMm >= end))
      return wouldBeInvalid ? [panelIndex] : []
    })
  }

  function renderReconciliation(response: ConfiguratorReconciliationResponse, persist = true) {
    if (!activeReconciliation || !reconciliationStatus || !reconciliationIssues || !reconciliationPrices) return
    activeReconciliation.response = response
    activeReconciliation.workingCommand = response.workingCommand
    activeReconciliation.reloadRequired = false
    const saved = !persist || saveReconciliationDraft()
    const blockers = response.issues.filter((issue): issue is Extract<ReconciliationIssue, { blocking: true }> => issue.blocking)
    reconciliationPrices.hidden = false
    reconciliationPrices.innerHTML = `<div><span>При сохранении</span><strong>${rubles.format(response.originalQuote.totalRub)} ₽</strong></div><div><span>Сейчас</span><strong>${response.currentQuote ? `${rubles.format(response.currentQuote.totalRub)} ₽` : 'после замены'}</strong></div>`
    reconciliationStatus.textContent = blockers.length > 0
      ? `Нужно решить ${blockers.length} ${blockers.length === 1 ? 'изменение' : 'изменения'}. Ничего не заменится автоматически.`
      : 'Все позиции доступны. Проверьте текущую цену и подтвердите её.'
    if (!saved) reconciliationStatus.textContent += ' Не удалось сохранить прогресс в браузере — освободите место и повторите действие.'
    reconciliationIssues.innerHTML = blockers.map((issue, index) => {
      const options = issue.replacementOptions.map((option) => `<option value="${escape(option.id)}">${escape(option.publicName)}</option>`).join('')
      const canRemove = issue.target.kind !== 'material'
      const dependentPanels = dependentPanelIndexes(issue, response)
        .map((panelIndex) => `<button type="button" data-remove-dependent-panel="${panelIndex}">Удалить связанную фальш-панель ${panelIndex + 1}</button>`)
        .join('')
      return `<article class="reconciliation-issue" data-issue-index="${index}"><div><strong>${escape(issue.originalSelection.publicName)}</strong><span>${escape(reconciliationTargetLabel(issue))}</span><p>${escape(issue.message)}</p></div>${options ? `<label>Безопасная замена<select data-replacement>${options}</select></label><button type="button" data-apply-replacement>Заменить</button>` : '<span>Совместимой замены нет.</span>'}${dependentPanels}${canRemove ? '<button type="button" data-remove-selection>Удалить позицию</button>' : ''}</article>`
    }).join('') || '<p>Недоступных позиций не осталось.</p>'
    reconciliationIssues.querySelectorAll<HTMLElement>('.reconciliation-issue').forEach((host) => {
      const issue = blockers[Number(host.dataset.issueIndex)]
      if (!issue) return
      host.querySelector<HTMLButtonElement>('[data-apply-replacement]')?.addEventListener('click', () => {
        const replacementId = host.querySelector<HTMLSelectElement>('[data-replacement]')?.value
        if (replacementId) void applyReconciliationReplacement(issue, replacementId)
      })
      host.querySelector<HTMLButtonElement>('[data-remove-selection]')?.addEventListener('click', () => {
        void removeReconciliationSelection(issue)
      })
      host.querySelectorAll<HTMLButtonElement>('[data-remove-dependent-panel]').forEach((button) => {
        button.addEventListener('click', () => {
          void removeReconciliationPanel(Number(button.dataset.removeDependentPanel))
        })
      })
    })
    if (reconciliationAcceptButton) reconciliationAcceptButton.hidden = response.currentQuote === null
    reconciliationRetryButton?.setAttribute('hidden', '')
  }

  async function applyReconciliationReplacement(
    issue: Extract<ReconciliationIssue, { blocking: true }>,
    replacementId: string,
  ) {
    if (!activeReconciliation || activeReconciliation.requestPending) return
    const option = issue.replacementOptions.find((item) => item.id === replacementId)
    if (!option) return
    const command = structuredClone(activeReconciliation.workingCommand)
    const target = issue.target
    if (target.kind === 'module' && option.kind === 'variant') {
      const row = command.rows.find((item) => item.row === target.row)
      const module = row?.modules[target.index]
      if (!module) return
      module.variantId = option.id
    } else if (target.kind === 'false_panel' && option.kind === 'variant') {
      const panel = command.falsePanels[target.index]
      if (!panel) return
      panel.variantId = option.id
    } else if (target.kind === 'material' && option.kind === 'material') {
      command[target.field] = option.id
    } else if (target.kind === 'trim' && option.kind === 'variant') {
      command[target.field] = option.id
    } else return
    const rollback = {
      command: structuredClone(activeReconciliation.workingCommand),
      response: activeReconciliation.response,
    }
    activeReconciliation.workingCommand = command
    await requestReconciliation(rollback)
  }

  async function removeReconciliationSelection(issue: Extract<ReconciliationIssue, { blocking: true }>) {
    if (!activeReconciliation || activeReconciliation.requestPending) return
    const command = structuredClone(activeReconciliation.workingCommand)
    const target = issue.target
    if (target.kind === 'module') {
      const row = command.rows.find((item) => item.row === target.row)
      if (!row?.modules[target.index]) return
      const moduleCount = command.rows.reduce((total, item) => total + item.modules.length, 0)
      if (moduleCount === 1) {
        if (window.confirm('Это последний модуль. Удалить сохранённую кухню и начать новую?')) abandonReconciliationForEmptyKitchen()
        return
      }
      row.modules.splice(target.index, 1)
      command.rows = command.rows.filter((item) => item.modules.length > 0)
    } else if (target.kind === 'false_panel') {
      command.falsePanels.splice(target.index, 1)
    } else if (target.kind === 'trim') {
      command[target.field] = null
    } else return
    const rollback = {
      command: structuredClone(activeReconciliation.workingCommand),
      response: activeReconciliation.response,
    }
    activeReconciliation.workingCommand = command
    await requestReconciliation(rollback)
  }

  async function removeReconciliationPanel(index: number) {
    if (!activeReconciliation || activeReconciliation.requestPending) return
    const command = structuredClone(activeReconciliation.workingCommand)
    if (!command.falsePanels[index]) return
    command.falsePanels.splice(index, 1)
    const rollback = {
      command: structuredClone(activeReconciliation.workingCommand),
      response: activeReconciliation.response,
    }
    activeReconciliation.workingCommand = command
    await requestReconciliation(rollback)
  }

  async function requestReconciliation(rollback: {
    command: ConfigurationQuoteRequest
    response: ConfiguratorReconciliationResponse | null
  } | null = null) {
    if (!activeReconciliation || activeReconciliation.requestPending || !reconciliationStatus) return
    const session = activeReconciliation
    const requestRevision = ++session.requestRevision
    const requestAbort = new AbortController()
    session.requestPending = true
    session.requestAbort = requestAbort
    reconciliationStatus.textContent = 'Сверяем сохранённую кухню с текущим каталогом…'
    reconciliationAcceptButton?.setAttribute('hidden', '')
    reconciliationRetryButton?.setAttribute('hidden', '')
    reconciliationCard?.setAttribute('aria-busy', 'true')
    setReconciliationControlsDisabled(true)
    if (!saveReconciliationDraft()) {
      session.requestPending = false
      session.requestAbort = null
      reconciliationCard?.removeAttribute('aria-busy')
      if (rollback?.response) {
        session.workingCommand = rollback.command
        renderReconciliation(rollback.response, false)
      } else {
        setReconciliationControlsDisabled(false)
        reconciliationRetryButton?.removeAttribute('hidden')
      }
      reconciliationStatus.textContent = 'Не удалось сохранить прогресс в браузере. Освободите место и повторите действие.'
      return
    }
    const response = await fetch(`${apiBase}/configurator/reconcile`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        sourceCommand: session.sourceCommand,
        workingCommand: session.workingCommand,
      }),
      signal: requestAbort.signal,
    }).catch(() => null)
    const payload = await response?.json().catch(() => null)
    if (activeReconciliation !== session || session.requestRevision !== requestRevision) return
    session.requestPending = false
    session.requestAbort = null
    reconciliationCard?.removeAttribute('aria-busy')
    if (!response?.ok) {
      const errorPayload = payload as { error?: { code?: string; message?: string } } | null
      session.reloadRequired = errorPayload?.error?.code === 'PUBLICATION_CHANGED'
      if (!session.reloadRequired && rollback?.response) {
        session.workingCommand = rollback.command
        renderReconciliation(rollback.response)
        reconciliationStatus.textContent = `${errorPayload?.error?.message ?? 'Изменение не удалось проверить.'} Изменение отменено — выберите другое действие.`
        return
      }
      setReconciliationControlsDisabled(false)
      reconciliationStatus.textContent = session.reloadRequired
        ? 'Каталог снова обновился. Обновите страницу: выбранные, но ещё не принятые замены придётся проверить заново.'
        : errorPayload?.error?.message ?? 'Не удалось сверить черновик. Проверьте подключение и повторите.'
      reconciliationRetryButton?.removeAttribute('hidden')
      return
    }
    renderReconciliation(payload as ConfiguratorReconciliationResponse)
  }

  function beginReconciliation(draft: ConfiguratorDraft) {
    if (!bootstrap) return
    const sourceCommand = draft.reconciliationSourceCommand ?? draft.command
    const mustRestart = draft.reconciliationSourceCommand !== null && draft.command.publicationId !== bootstrap.publicationId
    const workingCommand = mustRestart || draft.reconciliationSourceCommand === null
      ? { ...structuredClone(sourceCommand), publicationId: bootstrap.publicationId }
      : structuredClone(draft.command)
    activeReconciliation = {
      sourceCommand: structuredClone(sourceCommand),
      workingCommand,
      startSide: draft.uiOptions.startSide,
      response: null,
      reloadRequired: false,
      requestPending: false,
      requestRevision: 0,
      requestAbort: null,
    }
    hideDraftNotice()
    draftWriteBlocked = true
    app?.setAttribute('hidden', '')
    reconciliationCard?.removeAttribute('hidden')
    if (mustRestart && reconciliationStatus) {
      reconciliationStatus.textContent = 'Каталог обновился ещё раз. Ранее не принятые замены сброшены и будут проверены заново.'
    }
    void requestReconciliation()
  }

  function inspectStoredDraft(raw = localStorage.getItem(CONFIGURATOR_DRAFT_STORAGE_KEY), fromAnotherTab = false) {
    const result = readConfiguratorDraft(raw)
    if (result.status === 'absent') {
      if (fromAnotherTab) showDraftNotice('Черновик удалён в другой вкладке. Текущая кухня не изменена.', null, false, false)
      return
    }
    if (result.status === 'unsupported') {
      showDraftNotice('Этот черновик создан более новой версией сайта. Он не был применён.', null, false)
      return
    }
    if (result.status === 'corrupt') {
      showDraftNotice('Черновик повреждён и не был применён. Можно безопасно удалить его.', null, false)
      return
    }
    const compatibility = bootstrap ? validateDraftCompatibility(result.draft, bootstrap) : { status: 'corrupt' as const }
    const restored = bootstrap ? configuratorStateFromDraft(result.draft, bootstrap) : null
    if (compatibility.status === 'stale' || compatibility.status === 'reconciling') {
      showDraftNotice(
        compatibility.status === 'reconciling'
          ? 'Найдено незавершённое обновление сохранённой кухни. Продолжить сверку?'
          : 'Черновик относится к прошлой публикации. Сверить его с текущим каталогом?',
        result.draft,
        true,
      )
      return
    }
    if (!restored || compatibility.status !== 'ready') {
      showDraftNotice(
        'Черновик содержит несовместимые данные и не был применён. Можно безопасно удалить его.',
        null,
        false,
      )
      return
    }
    showDraftNotice(
      fromAnotherTab
        ? 'Черновик изменён в другой вкладке. Загрузить ту версию вместо текущей?'
        : result.migrated
          ? 'Найден черновик старой версии. Восстановить его в безопасном новом формате?'
          : 'Найден сохранённый черновик. Восстановить?',
      result.draft,
      true,
    )
  }

  function render() {
    if (!bootstrap || !catalog || !scene || !activeTitle) return
    syncControlsFromState()
    quotedFreeIntervals = null
    activeTitle.textContent = rowNames[activeRow]
    document.querySelectorAll<HTMLButtonElement>('.row-picker button').forEach((button) => button.classList.toggle('is-active', button.dataset.row === activeRow))
    const selectedSpan = selectedInterval?.row === activeRow ? selectedInterval.endMm - selectedInterval.startMm : null
    const available = bootstrap.variants.filter((item) => item.row === activeRow && item.configuration.straightEligible && ['ordinary', 'tall'].includes(item.configuration.role) && (selectedSpan === null || span(item) <= selectedSpan))
    catalog.innerHTML = available.map((item) => {
      const replacingIndex = replaceMode?.checked && selected?.row === activeRow ? selected.index : null
      const fits = fitsWall(activeRow, span(item), replacingIndex)
      return `<button type="button" data-add="${item.id}" ${fits ? '' : 'disabled'}><strong>${escape(item.publicName)}</strong><span>${item.dimensionsMm.width} мм · ${escape(item.sku)}${fits ? '' : ' · не помещается'}</span></button>`
    }).join('') || '<p>Для этого ряда пока нет совместимых модулей.</p>'
    catalog.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((button) => button.addEventListener('click', () => { void addModule(button.dataset.add!) }))

    scene.innerHTML = rows.map((row) => {
      const entries = [
        ...state.rows[row].map((item, index) => ({ kind: 'module' as const, item, index, startMm: item.startMm })),
        ...state.falsePanels.map((item, index) => ({ kind: 'panel' as const, item, index, startMm: item.startMm })).filter((item) => item.item.row === row),
      ].sort((left, right) => left.startMm - right.startMm)
      let previousEnd = 0
      const items = entries.map((entry) => {
        const itemSpan = entry.kind === 'panel' ? entry.item.widthMm : entry.item.cutWidthMm ?? span(findVariant(entry.item.variantId))
        const gap = Math.max(0, entry.startMm - previousEnd)
        previousEnd = entry.startMm + itemSpan
        const gapMarkup = gap > 0 ? `<span class="scene-gap" style="--span:${gap}" aria-label="Свободное место ${gap} мм"></span>` : ''
        if (entry.kind === 'panel') return `${gapMarkup}<button type="button" class="scene-module false-panel" style="--span:${itemSpan}" data-remove-panel="${entry.index}" aria-label="Удалить фальш-панель">Фальш<br /><small>${itemSpan} мм</small></button>`
        const variant = findVariant(entry.item.variantId)
        return `${gapMarkup}<button type="button" class="scene-module ${entry.item.withoutFacade ? 'without-facade' : ''} ${selected?.row === row && selected.index === entry.index ? 'is-selected' : ''}" style="--span:${itemSpan}" data-select-row="${row}" data-select-index="${entry.index}" aria-label="Настроить ${escape(variant.publicName)}"><span>${escape(variant.publicName)}</span><small>${itemSpan} мм</small></button>`
      }).join('')
      return `<div class="scene-row scene-${row}"><strong>${rowNames[row]}</strong><div class="scene-modules ${state.startSide === 'right' ? 'from-right' : ''}">${items || '<span class="scene-empty">Пусто</span>'}</div></div>`
    }).join('')
    scene.querySelectorAll<HTMLButtonElement>('[data-select-row]').forEach((button) => button.addEventListener('click', () => { selected = { row: button.dataset.selectRow as Row, index: Number(button.dataset.selectIndex) }; render() }))
    scene.querySelectorAll<HTMLButtonElement>('[data-remove-panel]').forEach((button) => button.addEventListener('click', () => {
      const panel = state.falsePanels[Number(button.dataset.removePanel)]
      if (panel) commitStateMutation(() => {
        state.falsePanels.splice(Number(button.dataset.removePanel), 1)
        reflow(panel.row)
      })
      render()
    }))
    if (suggestUpperButton) suggestUpperButton.hidden = !(['wall', 'mezzanine'].includes(activeRow) && state.rows.lower.length > 0)
    renderProperties()
    renderWallStatus()
    renderFreeIntervals()
    void requestQuote()
  }

  async function replacementProposal(replacementVariantId: string, selectedIndex: number) {
    if (!bootstrap) return null
    const response = await fetch(`${apiBase}/configurator/replacement-proposal`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        publicationId: bootstrap.publicationId, row: activeRow, selectedIndex, replacementVariantId, wallLengthMm: wallMm(),
        rows: rows.map((row) => ({ row, modules: state.rows[row] })),
        falsePanels: state.falsePanels.map(({ anchorIndex: _anchorIndex, ...panel }) => panel),
      }),
    }).catch(() => null)
    if (!response?.ok) {
      const payload = await response?.json().catch(() => null)
      showLocalMessage(payload?.error?.message ?? 'Не удалось подобрать безопасную замену.')
      return null
    }
    return response.json() as Promise<{ requiresConfirmation: boolean; changes: Array<{ row: Row; index: number; variantId: string; startMm: number }> }>
  }
  async function addModule(id: string) {
    findVariant(id)
    if (replaceMode?.checked && selected?.row === activeRow) {
      const selectedIndex = selected.index
      const current = state.rows[activeRow][selectedIndex]
      const nextVariant = findVariant(id)
      if (current) {
        if (!fitsWall(activeRow, span(nextVariant), selectedIndex)) { showLocalMessage('Этот модуль не помещается в заданную длину стены.'); return }
        const currentWidth = current.cutWidthMm ?? span(findVariant(current.variantId))
        if (['wall', 'mezzanine'].includes(activeRow) && currentWidth !== span(nextVariant)) {
          const proposal = await replacementProposal(id, selectedIndex)
          if (!proposal) return
          if (proposal.requiresConfirmation && !window.confirm('Изменится соседний верхний модуль. Применить предложенную пару модулей?')) return
          commitStateMutation(() => {
            for (const change of proposal.changes) {
              const item = state.rows[change.row][change.index]
              if (item) { item.variantId = change.variantId; item.startMm = change.startMm; item.cutWidthMm = null }
            }
          })
          render(); return
        }
        commitStateMutation(() => {
          const nextCurrent = state.rows[activeRow][selectedIndex]
          if (nextCurrent) { nextCurrent.variantId = id; nextCurrent.cutWidthMm = null; reflow(activeRow) }
        })
        render(); return
      }
    }
    if (selectedInterval?.row === activeRow) {
      const nextVariant = findVariant(id)
      if (span(nextVariant) > selectedInterval.endMm - selectedInterval.startMm || !isFreeInterval(selectedInterval)) { showLocalMessage('Выбранный модуль не помещается в свободный интервал.'); return }
      const intervalStart = selectedInterval.startMm
      commitStateMutation(() => {
        state.rows[activeRow].push({ variantId: id, startMm: intervalStart, cutWidthMm: null, withoutFacade: !state.facadesIncluded })
        state.rows[activeRow].sort((left, right) => left.startMm - right.startMm)
      })
      selectedInterval = null
      render(); return
    }
    if (!fitsWall(activeRow, span(findVariant(id)))) { showLocalMessage('Этот модуль не помещается в заданную длину стены.'); return }
    commitStateMutation(() => {
      state.rows[activeRow].push({ variantId: id, startMm: currentEnd(activeRow), cutWidthMm: null, withoutFacade: !state.facadesIncluded })
      reflow(activeRow)
    })
    render()
  }
  function removeModule(row: Row, index: number) {
    commitStateMutation(() => {
      state.rows[row].splice(index, 1)
      for (const panel of state.falsePanels) {
        if (panel.row === row && panel.position === 'between' && panel.anchorIndex !== undefined && panel.anchorIndex >= index) panel.anchorIndex -= 1
      }
      normalizePanels(row)
      reflow(row)
    })
    selected = null
    render()
  }

  function reflow(row: Row) {
    reflowConfiguratorRow(state, requiredBootstrap(), row)
  }
  function normalizePanels(row: Row) {
    normalizeFalsePanels(state, row)
  }
  function renderProperties() {
    if (!properties || !selected) { properties?.setAttribute('hidden', ''); return }
    const item = state.rows[selected.row][selected.index]
    if (!item) { selected = null; properties.setAttribute('hidden', ''); return }
    const variant = findVariant(item.variantId)
    const selectedWidth = item.cutWidthMm ?? span(variant)
    properties.removeAttribute('hidden')
    properties.innerHTML = `<div><strong>${escape(variant.publicName)}</strong><span>${selectedWidth} мм</span></div><div class="property-actions"><button type="button" data-action="left" ${selected.index === 0 ? 'disabled' : ''}>←</button><button type="button" data-action="right" ${selected.index === state.rows[selected.row].length - 1 ? 'disabled' : ''}>→</button><button type="button" data-action="duplicate">Дублировать</button><button type="button" data-action="remove">Удалить</button><button type="button" data-action="facade">${item.withoutFacade ? 'Вернуть фасад' : 'Без фасада'}</button></div>${variant.cutToWidth.allowed ? `<label class="cut-control">Подрезать до, мм <input id="cut-width" type="number" inputmode="numeric" min="${Math.max(1, span(variant) - 50)}" max="${span(variant)}" value="${selectedWidth}" /><button type="button" data-action="cut">Применить</button><button type="button" data-action="reset-cut">Стандарт</button></label>` : ''}`
    properties.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => button.addEventListener('click', () => updateSelected(button.dataset.action!)))
  }
  function updateSelected(action: string) {
    if (!selected) return
    const selectedRow = selected.row
    const selectedIndex = selected.index
    const existing = state.rows[selectedRow][selectedIndex]
    if (!existing) return
    if (action === 'remove') { removeModule(selected.row, selected.index); return }
    const cutWidth = action === 'cut' ? Number(properties?.querySelector<HTMLInputElement>('#cut-width')?.value) : null
    commitStateMutation(() => {
      const items = state.rows[selectedRow]
      const item = items[selectedIndex]
      if (!item) return
      if (action === 'left' && selectedIndex > 0) { [items[selectedIndex - 1], items[selectedIndex]] = [items[selectedIndex]!, items[selectedIndex - 1]!]; selected!.index -= 1 }
      if (action === 'right' && selectedIndex < items.length - 1) { [items[selectedIndex + 1], items[selectedIndex]] = [items[selectedIndex]!, items[selectedIndex + 1]!]; selected!.index += 1 }
      if (action === 'duplicate') { items.splice(selectedIndex + 1, 0, { ...item }); selected!.index += 1 }
      if (action === 'facade') item.withoutFacade = !item.withoutFacade
      if (action === 'cut') item.cutWidthMm = Number.isInteger(cutWidth) ? cutWidth : null
      if (action === 'reset-cut') item.cutWidthMm = null
      reflow(selectedRow)
    })
    render()
  }
  function suggestUpper() {
    if (!bootstrap || !['wall', 'mezzanine'].includes(activeRow)) return
    if (state.rows[activeRow].length > 0 && !window.confirm(`Заменить текущий ${rowNames[activeRow].toLowerCase()} предложением?`)) return
    const familyKey = activeRow === 'wall' ? 'wall-shelf' : 'mezzanine'
    commitStateMutation(() => {
      state.falsePanels = state.falsePanels.filter((item) => item.row !== activeRow)
      state.rows[activeRow] = state.rows.lower.flatMap((lower) => {
        const lowerVariant = findVariant(lower.variantId)
        if (lowerVariant.configuration.role === 'tall') return []
        const candidate = bootstrap!.variants.find((item) => item.familyKey === familyKey && span(item) === (lower.cutWidthMm ?? span(lowerVariant)))
        return candidate ? [{ variantId: candidate.id, startMm: lower.startMm, cutWidthMm: null, withoutFacade: !state.facadesIncluded }] : []
      })
      normalizePanels(activeRow)
      reflow(activeRow)
    })
    selected = null; render()
  }

  async function requestQuote() {
    if (!bootstrap || !quoteTotal || !quoteStatus || !specification || !height || !length) return
    const currentIntent = ++intent
    const command = buildConfigurationCommand(state, `phone-${currentIntent}`)
    const fingerprint = JSON.stringify(state)
    latestQuote = null
    acceptQuoteButton?.setAttribute('hidden', '')
    quoteAbort?.abort()
    if (!command) {
      quoteTotal.textContent = 'Добавьте модуль'
      if (quoteVat) quoteVat.textContent = ''
      quoteStatus.textContent = 'Цена появится после выбора модуля.'
      specification.textContent = 'Пока нет позиций.'
      height.textContent = 'Высота кухни: —'
      renderWallStatus()
      return
    }
    quoteStatus.textContent = 'Пересчитываем цену…'
    quoteAbort = new AbortController()
    const response = await fetch(`${apiBase}/configurator/quote`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(command), signal: quoteAbort.signal,
    }).catch(() => null)
    if (currentIntent !== intent || fingerprint !== JSON.stringify(state)) return
    if (!response || !response.ok) {
      const payload = await response?.json().catch(() => null)
      quoteStatus.textContent = payload?.error?.message ?? 'Не удалось посчитать. Проверьте подключение и повторите.'
      return
    }
    const quote = await response.json() as ConfigurationQuoteResponse
    if (quote.intentId !== `phone-${currentIntent}`) return
    latestQuote = quote
    if (stateModel.acceptedQuote && !acceptanceMatchesQuote(stateModel.acceptedQuote, quote)) {
      stateModel.clearAcceptance()
      scheduleDraftSave()
    }
    quoteTotal.textContent = `${rubles.format(quote.totalRub)} ₽`
    if (quoteVat) quoteVat.textContent = `в том числе НДС ${Number(quote.includedVatRub).toLocaleString('ru-RU', { minimumFractionDigits: 2 })} ₽`
    quoteStatus.textContent = quote.warnings.length ? quote.warnings.join(' ') : 'Цена рассчитана по опубликованной версии каталога.'
    height.textContent = `Высота кухни: ${quote.kitchenHeightMm} мм`
    renderWallStatus(quote.rowSpansMm)
    quotedFreeIntervals = quote.freeIntervals
    renderFreeIntervals()
    specification.innerHTML = quote.specification.map((line: { label: string; quantity: number; unit: string; amountRub: number; customerSupplied: boolean }) => `<div class="spec-line ${line.customerSupplied ? 'customer-supplied' : ''}"><span>${escape(line.label)} · ${line.quantity} ${escape(line.unit)}</span><strong>${line.customerSupplied ? 'покупают сами' : `${rubles.format(line.amountRub)} ₽`}</strong></div>`).join('')
    if (acceptQuoteButton) {
      acceptQuoteButton.hidden = false
      acceptQuoteButton.disabled = acceptanceMatchesQuote(stateModel.acceptedQuote, quote)
      acceptQuoteButton.textContent = acceptQuoteButton.disabled ? 'Цена принята' : 'Принять цену'
    }
  }

  function fillTrimOptions() {
    if (!bootstrap || !plinthSelect || !crownSelect) return
    for (const variant of bootstrap.variants) {
      if (variant.configuration.role === 'plinth') plinthSelect.insertAdjacentHTML('beforeend', `<option value="${variant.id}">${escape(variant.publicName)}</option>`)
      if (variant.configuration.role === 'crown') crownSelect.insertAdjacentHTML('beforeend', `<option value="${variant.id}">${escape(variant.publicName)}</option>`)
    }
  }

  async function start() {
    try {
      const response = await fetch(`${apiBase}/configurator/bootstrap`)
      if (!response.ok) throw new Error((await response.json().catch(() => null))?.error?.message ?? 'Конфигуратор пока не опубликован')
      const nextBootstrap: Bootstrap = await response.json()
      bootstrap = nextBootstrap
      if (!bodySelect || !facadeSelect) throw new Error('Не удалось подготовить форму')
      bodySelect.innerHTML = options(nextBootstrap.materials.filter((item) => item.kind === 'body'))
      facadeSelect.innerHTML = options(nextBootstrap.materials.filter((item) => item.kind === 'facade'))
      fillTrimOptions()
      stateModel.restore(createInitialConfiguratorState(nextBootstrap))
      state = stateModel.state
      loading?.setAttribute('hidden', '')
      app?.removeAttribute('hidden')
      render()
      inspectStoredDraft()
    } catch (caught) {
      loading?.setAttribute('hidden', '')
      if (error) { error.hidden = false; error.textContent = caught instanceof Error ? caught.message : 'Не удалось открыть конфигуратор' }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.row-picker button').forEach((button) => button.addEventListener('click', () => { activeRow = button.dataset.row as Row; render() }))
  bodySelect?.addEventListener('change', () => { commitStateMutation(() => { state.bodyMaterialId = bodySelect.value }); render() })
  facadeSelect?.addEventListener('change', () => { commitStateMutation(() => { state.facadeMaterialId = facadeSelect.value || null }); render() })
  packagingEnabled?.addEventListener('change', () => { commitStateMutation(() => { state.packagingIncluded = packagingEnabled.checked }); render() })
  countertop?.addEventListener('change', () => {
    commitStateMutation(() => { state.countertopThicknessMm = Number(countertop.value) as 12 | 20 | 38 })
    render()
  })
  plinthSelect?.addEventListener('change', () => { commitStateMutation(() => { state.plinthVariantId = plinthSelect.value || null }); render() })
  crownSelect?.addEventListener('change', () => { commitStateMutation(() => { state.crownVariantId = crownSelect.value || null }); render() })
  wallLength?.addEventListener('change', () => {
    // Blurring this input happens immediately before tapping a catalogue card.
    // Do not replace the card synchronously, or that tap is lost on mobile.
    if (syncWallLengthFromControl()) scheduleDraftSave()
    renderWallStatus()
    renderFreeIntervals()
    void requestQuote()
  })
  startSide?.addEventListener('change', () => {
    commitStateMutation(() => { state.startSide = startSide.value === 'right' ? 'right' : 'left' })
    render()
  })
  replaceMode?.addEventListener('change', () => render())
  facadesEnabled?.addEventListener('change', () => {
    commitStateMutation(() => {
      state.facadesIncluded = facadesEnabled.checked
      for (const row of rows) for (const module of state.rows[row]) module.withoutFacade = !state.facadesIncluded
    })
    render()
  })
  document.querySelector<HTMLButtonElement>('#add-false-panel')?.addEventListener('click', () => {
    if (!bootstrap) return
    const position = (falsePanelPosition?.value ?? 'end') as FalsePanel['position']
    const panel = bootstrap.variants.find((item) => item.configuration.role === 'false_panel' && item.configuration.falsePanelPositions.includes(position))
    if (!panel) { showLocalMessage('В опубликованном каталоге нет фальш‑панели для этой позиции.'); return }
    if (!panel.configuration.falsePanelPositions.includes(position)) { showLocalMessage('Эта фальш‑панель не поддерживает выбранную позицию.'); return }
    if (position === 'between' && state.rows[activeRow].length < 2) { showLocalMessage('Чтобы поставить панель между модулями, добавьте в ряд минимум два модуля.'); return }
    const selectedIndex = selected?.row === activeRow ? selected.index : 0
    const anchorIndex = position === 'between' ? Math.min(selectedIndex, state.rows[activeRow].length - 2) : undefined
    if (!fitsFalsePanel(activeRow, span(panel), position, anchorIndex)) { showLocalMessage('Фальш‑панель не помещается в заданную длину стены.'); return }
    commitStateMutation(() => {
      state.falsePanels = state.falsePanels.filter((item) => item.row !== activeRow)
      state.falsePanels.push({ variantId: panel.id, row: activeRow, startMm: 0, widthMm: span(panel), position, ...(anchorIndex === undefined ? {} : { anchorIndex }) })
      reflow(activeRow)
    })
    render()
  })
  suggestUpperButton?.addEventListener('click', suggestUpper)
  undoButton?.addEventListener('click', undo)
  redoButton?.addEventListener('click', redo)
  restoreDraftButton?.addEventListener('click', () => {
    if (!pendingDraft || !bootstrap) return
    const draft = pendingDraft
    const compatibility = validateDraftCompatibility(draft, bootstrap)
    if (compatibility.status === 'stale' || compatibility.status === 'reconciling') {
      beginReconciliation(draft)
      return
    }
    const restored = configuratorStateFromDraft(draft, bootstrap)
    if (!restored || compatibility.status !== 'ready') {
      showDraftNotice('Черновик больше нельзя безопасно восстановить.', null, false)
      return
    }
    hideDraftNotice()
    restoreHistory(restored, compatibility.acceptedQuote)
  })
  discardDraftButton?.addEventListener('click', () => {
    localStorage.removeItem(CONFIGURATOR_DRAFT_STORAGE_KEY)
    hideDraftNotice()
  })
  acceptQuoteButton?.addEventListener('click', () => {
    if (!latestQuote) return
    stateModel.accept(acceptedQuoteFromResponse(latestQuote))
    scheduleDraftSave()
    acceptQuoteButton.disabled = true
    acceptQuoteButton.textContent = 'Цена принята'
  })
  reconciliationRetryButton?.addEventListener('click', () => {
    if (activeReconciliation?.reloadRequired) window.location.reload()
    else void requestReconciliation()
  })
  reconciliationAcceptButton?.addEventListener('click', () => {
    if (!activeReconciliation?.response?.currentQuote || !bootstrap) return
    const acceptedQuote = acceptedQuoteFromResponse(activeReconciliation.response.currentQuote)
    const resolvedDraft: ConfiguratorDraft = {
      draftSchemaVersion: 3,
      savedAt: new Date().toISOString(),
      command: activeReconciliation.response.workingCommand,
      reconciliationSourceCommand: null,
      uiOptions: { startSide: activeReconciliation.startSide },
      acceptedQuote,
    }
    const restored = configuratorStateFromDraft(resolvedDraft, bootstrap)
    if (!restored) {
      if (reconciliationStatus) reconciliationStatus.textContent = 'Обновлённую кухню не удалось открыть. Повторите сверку.'
      return
    }
    closeReconciliation()
    draftWriteBlocked = false
    app?.removeAttribute('hidden')
    restoreHistory(restored, acceptedQuote)
  })
  reconciliationDiscardButton?.addEventListener('click', () => {
    localStorage.removeItem(CONFIGURATOR_DRAFT_STORAGE_KEY)
    closeReconciliation()
    draftWriteBlocked = false
    app?.removeAttribute('hidden')
    if (bootstrap) {
      stateModel.restore(createInitialConfiguratorState(bootstrap))
      state = stateModel.state
      render()
    }
  })
  window.addEventListener('storage', (event) => {
    if (event.key !== CONFIGURATOR_DRAFT_STORAGE_KEY) return
    if (activeReconciliation) {
      closeReconciliation()
      draftWriteBlocked = false
      app?.removeAttribute('hidden')
    }
    inspectStoredDraft(event.newValue, true)
  })
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flushDraft() })
  window.addEventListener('pagehide', flushDraft)
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null
    if (link && link.origin === window.location.origin) flushDraft()
  }, { capture: true })
  document.addEventListener('keydown', (event) => {
    if (!(event.ctrlKey || event.metaKey) || event.altKey) return
    const target = event.target
    if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return
    if (event.key.toLowerCase() !== 'z') return
    event.preventDefault()
    if (event.shiftKey) redo()
    else undo()
  })
  void start()
</script>

