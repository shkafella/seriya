---
interface Props {
  title: string
  description: string
  releaseId: string
}

const { title, description, releaseId } = Astro.props
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl ? new URL(Astro.url.pathname, publicWebsiteUrl).toString() : undefined
---

<!doctype html>
<html lang="ru" data-release-id={releaseId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="catalog-release" content={releaseId} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Серийка</a>
      <nav aria-label="Основное меню"><a href="/catalog">Каталог кухонь</a></nav>
    </header>
    <slot />
    <footer>Серийная мебель для мебельных компаний · цены без упаковки и столешницы</footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #1f2924; background: #f4f1e9; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; }
  .site-header { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 20px; background: rgba(255,255,255,.88); border-bottom: 1px solid #ded8cb; position: sticky; top: 0; z-index: 10; backdrop-filter: blur(10px); }
  .brand { font-weight: 850; text-decoration: none; font-size: 1.25rem; }
  .site-header nav a { font-size: .92rem; text-underline-offset: 4px; }
  main { width: min(1180px, 100%); margin-inline: auto; padding: 36px 16px 72px; }
  .eyebrow { margin: 0 0 10px; color: #51705d; font-size: .78rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.2rem, 9vw, 5rem); line-height: .98; letter-spacing: -.045em; }
  h2 { margin: 0; font-size: 1.35rem; line-height: 1.15; }
  .lede { max-width: 760px; color: #56615b; line-height: 1.55; font-size: 1.05rem; }
  .catalog-grid { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 22px; }
  .catalog-card { display: grid; grid-template-columns: 112px minmax(0,1fr); gap: 14px; min-width: 0; padding: 12px; border: 1px solid #ddd6c8; border-radius: 18px; background: #fff; box-shadow: 0 8px 25px rgba(45,48,42,.04); }
  .catalog-card[hidden] { display: none; }
  .catalog-card img { width: 112px; aspect-ratio: 1; object-fit: cover; border-radius: 12px; background: #f5f1e8; }
  .card-body { min-width: 0; display: grid; align-content: start; gap: 8px; }
  .card-body a { text-decoration: none; }
  .meta { color: #66716a; font-size: .84rem; line-height: 1.4; }
  .price { font-weight: 850; font-size: 1.05rem; }
  .price-label { display: block; font-size: .73rem; font-weight: 500; color: #69736d; }
  .filters { margin-top: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px; border-radius: 18px; background: #e5eade; }
  .filter { display: grid; gap: 5px; font-size: .75rem; font-weight: 750; }
  select, button, input { min-height: 44px; border: 1px solid #c5cdbf; border-radius: 10px; padding: 0 10px; background: white; color: #1f2924; font: inherit; }
  button { cursor: pointer; font-weight: 750; }
  .filter-actions { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .empty { margin: 24px 0; padding: 24px; border: 1px dashed #9ba895; border-radius: 18px; text-align: center; }
  .back { display: inline-block; margin-bottom: 24px; text-underline-offset: 4px; }
  .family-hero { display: grid; gap: 24px; }
  .family-hero img { width: 100%; max-height: 520px; object-fit: contain; border-radius: 24px; background: #fff; border: 1px solid #ddd6c8; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; padding: 0; list-style: none; }
  .chips li { padding: 7px 10px; border-radius: 999px; background: #e5eade; font-size: .78rem; }
  .exclusions { padding: 16px 18px; border-radius: 14px; background: #fff7e8; color: #5d4d34; line-height: 1.55; }
  .variant-list { display: grid; gap: 10px; padding: 0; list-style: none; }
  .variant-list li { display: grid; gap: 5px; padding: 14px; background: #fff; border: 1px solid #ddd6c8; border-radius: 14px; }
  footer { padding: 28px 16px; text-align: center; border-top: 1px solid #ded8cb; color: #69736d; font-size: .8rem; }
  @media (min-width: 720px) {
    main { padding: 56px 28px 96px; }
    .site-header { padding-inline: 32px; }
    .filters { grid-template-columns: repeat(4, 1fr); }
    .filter-actions { grid-column: 1 / -1; }
    .catalog-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; }
    .family-hero { grid-template-columns: minmax(0,1fr) minmax(320px,.85fr); align-items: start; }
    .variant-list { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (min-width: 1080px) { .catalog-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
</style>
