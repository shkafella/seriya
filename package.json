{
  "name": "seriya",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "webapp",
    "website",
    "backend",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^1.19.14",
    "esbuild": "^0.28.1",
    "hono": "^4.12.30",
    "js-yaml": "^4.3.0",
    "qs": "^6.15.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "dev:webapp": "bun run --cwd webapp dev",
    "dev:website": "bun run --cwd website dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --filter '*' --sequential build",
    "build:webapp": "bun run --cwd webapp build",
    "build:website": "bun run --cwd website build",
    "build:backend": "bun run --cwd backend build",
    "catalog:check": "bun scripts/catalog-check.mjs",
    "test:catalog": "bun scripts/run-python.mjs -m unittest discover -s scripts/catalog -p \"test_*.py\" && bun run catalog:check",
    "catalog:assets": "bun scripts/run-python.mjs scripts/catalog-assets/generate_schematics.py --seed catalog/seed/catalog.v1.json --output website/public/catalog --manifest website/public/catalog/manifest.v1.json",
    "catalog:assets:fixtures": "bun scripts/run-python.mjs scripts/catalog-assets/inspect_basis.py --source .scratch/bazis-shef/шеф --fixtures scripts/catalog-assets/basis-fixtures.v1.json --output .scratch/catalog-assets-fixtures",
    "test:assets": "bun scripts/run-python.mjs -m unittest discover -s scripts/catalog-assets -p \"test_*.py\"",
    "architecture:check": "bun scripts/architecture-check.mjs",
    "typecheck": "bun run --filter '*' --sequential typecheck",
    "typecheck:webapp": "bun run --cwd webapp typecheck",
    "typecheck:website": "bun run --cwd website typecheck",
    "typecheck:backend": "bun run --cwd backend typecheck",
    "test": "bun run test:catalog && bun run test:assets && bun run test:scripts && bun run test:contracts && bun run test:backend && bun run test:website && bun run test:webapp",
    "test:scripts": "bun test scripts/repo-env.test.mjs scripts/architecture-check.test.mjs scripts/deploy-contract.test.mjs",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:backend": "bun run --cwd backend test",
    "test:backend:unit": "bun run --cwd backend test:unit",
    "test:backend:integration": "bun run --cwd backend test:integration",
    "test:website": "bun run --cwd website test",
    "test:webapp": "bun run --cwd webapp test",
    "smoke:backend:docker": "bun run --cwd backend smoke:docker",
    "e2e:webapp": "bun run --cwd webapp e2e"
    ,"e2e:configurator": "bun run --cwd webapp e2e:configurator"
  }
}
