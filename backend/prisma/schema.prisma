  leadId                   String                     @unique @map("lead_id") @db.Uuid
  kind                     LeadErasureKind
  operationDigest          String                     @map("operation_digest")
  digestKeyVersion         Int                        @map("digest_key_version")
  ledgerKeyVersion         Int                        @map("ledger_key_version")
  phase                    LeadErasurePhase           @default(PREPARED)
  notificationQuiescenceAt DateTime?                  @map("notification_quiescence_at")
  markerTimestamp          DateTime?                  @map("marker_timestamp")
  markerPayloadChecksum    String?                    @map("marker_payload_checksum")
  coverageSequence         BigInt?                    @map("coverage_sequence")
  coverageHash             String?                    @map("coverage_hash")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  lead                     Lead                       @relation(fields: [leadId], references: [id], onDelete: Restrict)
  markerAttempts           LeadErasureMarkerAttempt[]

  @@unique([digestKeyVersion, operationDigest])
  @@map("lead_erasure_requests")
}

model LeadErasureMarkerAttempt {
  id                           String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId                    String?                  @map("request_id") @db.Uuid
  reservationId                BigInt                   @map("reservation_id")
  normalizedCapacityTransition Json                     @map("normalized_capacity_transition")
  operationDigest              String                   @map("operation_digest")
  digestKeyVersion             Int                      @map("digest_key_version")
  attemptNumber                Int                      @map("attempt_number")
  objectLocator                String                   @unique @map("object_locator")
  markerSchemaVersion          Int                      @map("marker_schema_version")
  markerKeyVersion             Int                      @map("marker_key_version")
  plaintextChecksum            String                   @map("plaintext_checksum")
  ciphertextChecksum           String                   @map("ciphertext_checksum")
  ciphertextSize               BigInt                   @map("ciphertext_size")
  state                        LeadErasureMarkerState   @default(PREPARED)
  objectVersion                String?                  @map("object_version")
  objectEtag                   String?                  @map("object_etag")
  coverageSequence             BigInt?                  @map("coverage_sequence")
  coverageHash                 String?                  @map("coverage_hash")
  lastErrorCode                String?                  @map("last_error_code")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  request                      LeadErasureRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  reservation                  LeadAdmissionReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([digestKeyVersion, operationDigest, attemptNumber])
  @@index([state])
  @@map("lead_erasure_marker_attempts")
}

model SubmissionKeyAbandonmentBatch {
  id                        String                             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operationId               String                             @unique @map("operation_id") @db.Uuid
  operationDigest           String                             @map("operation_digest")
  digestKeyVersion          Int                                @map("digest_key_version")
  orderedMembershipChecksum String                             @map("ordered_membership_checksum")
  cleanupObligationId       String                             @unique @map("cleanup_obligation_id") @db.Uuid
  markerLocator             String?                            @unique @map("marker_locator")
  markerObjectVersion       String?                            @map("marker_object_version")
  markerChecksum            String?                            @map("marker_checksum")
  markerSize                BigInt?                            @map("marker_size")
  coverageSequence          BigInt?                            @map("coverage_sequence")
  coverageHash              String?                            @map("coverage_hash")
  checkpointSequence        BigInt?                            @map("checkpoint_sequence")
  state                     SubmissionKeyAbandonmentBatchState @default(PREPARED)
  lastErrorCode             String?                            @map("last_error_code")
  createdAt                 DateTime                           @default(now()) @map("created_at")
  updatedAt                 DateTime                           @updatedAt @map("updated_at")
  attempts                  SubmissionKeyAbandonmentAttempt[]

  @@unique([digestKeyVersion, operationDigest])
  @@map("submission_key_abandonment_batches")
}

model SubmissionKeyAbandonmentAttempt {
  id                    String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  submissionKeyId       String?                        @map("submission_key_id") @db.Uuid
  reservationId         BigInt                         @map("reservation_id")
  normalizedBeforeState Json                           @map("normalized_before_state")
  normalizedAfterState  Json                           @map("normalized_after_state")
  operationId           String                         @unique @map("operation_id") @db.Uuid
  operationDigest       String                         @map("operation_digest")
  digestKeyVersion      Int                            @map("digest_key_version")
  reason                String
  denyUntil             DateTime                       @map("deny_until")
  batchId               String?                        @map("batch_id") @db.Uuid
  state                 SubmissionKeyAbandonmentState  @default(PREPARED)
  reconciliationError   String?                        @map("reconciliation_error")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  submissionKey         LeadSubmissionKey?             @relation(fields: [submissionKeyId], references: [id], onDelete: SetNull)
  reservation           LeadAdmissionReservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  batch                 SubmissionKeyAbandonmentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([digestKeyVersion, operationDigest])
  @@index([state, denyUntil])
  @@map("submission_key_abandonment_attempts")
}
