generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String                          @unique
  passwordHash      String                          @map("password_hash")
  displayName       String?                         @map("display_name")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")
  sessions          AuthSession[]
  ownerIdentity     OwnerIdentity?
  leadStatusChanges LeadStatusHistory[]
  policyWithdrawals LeadPolicyCandidateWithdrawal[]

  @@map("users")
}

enum CatalogActivationState {
  IDLE
  MAINTENANCE
}

enum CatalogPublicationStatus {
  CANDIDATE
  ACTIVE
  SUPERSEDED
}

enum CatalogAssetStatus {
  DEVELOPMENT
  APPROVED
  REJECTED
}

enum ActivationAttemptStatus {
  PREPARED
  APPLICATION_SWITCHED
  PUBLICATION_SWITCHED
  VERIFIED
  ROLLED_BACK
  FAILED
}

enum LeadPolicyDeliveryMode {
  TELEGRAM_ENABLED
  TELEGRAM_DISABLED
}

enum LeadPolicyTransitionPhase {
  IDLE
  PREPARED
  RETENTION_WORK
  NOTIFICATION_WORK
  READY
  ACTIVATION_PENDING
  ABORT_PENDING
  TERMINAL
}

enum LeadPolicyTerminalDirection {
  ACTIVATION_PENDING
  ABORT_PENDING
}

enum LeadPolicyCommandKind {
  START
  ACTIVATE
  ABORT
}

enum ProtectionStatus {
  READY
  BLOCKED
}

enum BackupScope {
  CORE
  LEAD
}

enum BackupArtifactState {
  PREPARED
  OBJECTS_VERIFIED
  ADMISSION_PUBLISHED
  ADMISSION_ACKNOWLEDGED
  READY
  RETIREMENT_PREPARED
  DENIAL_HEAD_PUBLISHED
  DENIAL_DB_ACKNOWLEDGED
  ABANDON_PREPARED
  ABANDONMENT_RECORD_PUBLISHED
  ABANDONMENT_DB_ACKNOWLEDGED
  OBJECTS_PURGED
  PURGE_RECEIPT_PUBLISHED
  PURGE_RECEIPT_DB_ACKNOWLEDGED
  RETIRED
  ABANDONED
}

enum RecoveryChainKind {
  CORE_BACKUP_HEAD
  LEAD_BACKUP_HEAD
  LEAD_ERASURE_COVERAGE
  LEAD_POLICY_CONFIG_EPOCH
  ACTIVE_HOST_EPOCH
}

enum RecoveryControlStatus {
  IDLE
  PREPARED
  ACKNOWLEDGED
  BLOCKED
}

enum CryptoVersionLifecycle {
  READABLE_INACTIVE
  ACTIVE_WRITER
  RETIRING
  RETIRED
}

enum RecoveryProviderScope {
  GLOBAL
  CORE
  LEAD
}

enum RecoveryProviderOperationLifecycle {
  PREPARED
  ISSUED
  RESULT_RECORDED
  COMPLETED
  FENCE_REQUESTED
  FENCE_ACKNOWLEDGED
  SWEEP_ONE_RECORDED
  SWEEP_TWO_RECORDED
  DRAINED
}

enum LeadSubmissionKeyState {
  OPEN
  SUBMITTING
  ABANDONMENT_PENDING
  COMMITTED
  TOMBSTONED
  ABANDONED_TOMBSTONE
}

enum LeadAdmissionReservationLifecycle {
  OPEN_ACTIVE
  LEAD_ACTIVE
  PENDING
  TERMINAL_RECOVERY_PINNED
  RELEASED
}

enum LeadTombstoneUnitState {
  ACTIVE_RESERVED
  ACTIVE_LEAD_RESERVED
  PENDING_TOMBSTONE
  LIVE_TOMBSTONE
  ARTIFACT_PINNED
  FREE
}

enum LeadAttemptUnitState {
  ACTIVE_RESERVED
  ACTIVE_LEAD_RESERVED
  PENDING_ATTEMPT
  ARTIFACT_PINNED
  FREE
}

enum LeadCleanupUnitState {
  ACTIVE_RESERVED
  ACTIVE_LEAD_RESERVED
  PENDING_UNBATCHED
  PENDING_ERASURE
  UNCHECKPOINTED_BATCH
  UNCHECKPOINTED_ERASURE
  ARTIFACT_PINNED
  FREE
}

enum LeadLifecycle {
  ACTIVE
  ERASURE_PENDING
}

enum LeadWorkflowStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum LeadNotificationStatus {
  PENDING
  LEASED
  DISPATCH_STARTED
  SENT
  FAILED
  DELIVERY_UNCERTAIN
  SUPPRESSED
  CANCELLED_POLICY
}

enum LeadErasureKind {
  MANUAL
  EXPIRY
}

enum LeadErasurePhase {
  PREPARED
  QUIESCING
  MARKER_PENDING
  COVERAGE_PENDING
  FINALIZING
}

enum LeadErasureMarkerState {
  PREPARED
  UPLOADED
  BYTE_VERIFIED
  HEAD_PUBLISHED
  PURGE_PENDING
  PURGED
}

enum SubmissionKeyAbandonmentState {
  PREPARED
  BATCHED
  MARKER_PENDING
  COVERAGE_PENDING
  TERMINAL
  RECONCILIATION_REQUIRED
}

enum SubmissionKeyAbandonmentBatchState {
  PREPARED
  UPLOADED
  BYTE_VERIFIED
  HEAD_PUBLISHED
  CHECKPOINTED
  TERMINAL
  PURGE_PENDING
  PURGED
}

model OwnerIdentity {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey String   @unique @default("owner") @map("singleton_key")
  userId       String   @unique @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("owner_identities")
}

model CatalogState {
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey        String                 @unique @default("catalog") @map("singleton_key")
  revision            Int                    @default(0)
  activePublicationId String?                @unique @map("active_publication_id") @db.Uuid
  activationState     CatalogActivationState @default(IDLE) @map("activation_state")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  activePublication   CatalogPublication?    @relation("ActiveCatalogPublication", fields: [activePublicationId], references: [id], onDelete: Restrict)

  @@map("catalog_state")
}

model CatalogSourceRecord {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceRecordId String          @unique @map("source_record_id")
  sourceChecksum String          @map("source_checksum")
  sourceData     Json            @map("source_data")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  variant        CatalogVariant?

  @@map("catalog_source_records")
}

model CatalogFamily {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                String           @unique
  slug               String           @unique
  importedPublicName String           @map("imported_public_name")
  publicName         String           @map("public_name")
  description        String           @default("")
  row                String
  purposes           Json             @default("[]")
  functions          Json             @default("[]")
  isActive           Boolean          @default(true) @map("is_active")
  sourceManaged      Boolean          @default(true) @map("source_managed")
  ownerEditedFields  Json             @default("[]") @map("owner_edited_fields")
  revision           Int              @default(0)
  assetId            String?          @map("asset_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  asset              CatalogAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  variants           CatalogVariant[]

  @@map("catalog_families")
}

model CatalogVariant {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceRecordId    String?              @unique @map("source_record_id") @db.Uuid
  familyId          String               @map("family_id") @db.Uuid
  sku               String               @unique
  importedData      Json                 @map("imported_data")
  publicName        String               @map("public_name")
  heightMm          Int                  @map("height_mm")
  widthMm           Int                  @map("width_mm")
  depthMm           Int                  @map("depth_mm")
  layoutSpanMm      Int?                 @map("layout_span_mm")
  bodyM2            Decimal              @map("body_m2") @db.Decimal(12, 4)
  facadeM2          Decimal              @map("facade_m2") @db.Decimal(12, 4)
  hdfM2             Decimal              @map("hdf_m2") @db.Decimal(12, 4)
  fastenerChargeRub Decimal              @map("fastener_charge_rub") @db.Decimal(12, 2)
  cutPolicy         String               @map("cut_policy")
  configurationData Json                 @default("{}") @map("configuration_data")
  variantData       Json                 @map("variant_data")
  fastenersData     Json                 @map("fasteners_data")
  isActive          Boolean              @default(true) @map("is_active")
  isComplete        Boolean              @default(true) @map("is_complete")
  sourceManaged     Boolean              @default(true) @map("source_managed")
  ownerEditedFields Json                 @default("[]") @map("owner_edited_fields")
  revision          Int                  @default(0)
  assetId           String?              @map("asset_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  sourceRecord      CatalogSourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  family            CatalogFamily        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  asset             CatalogAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  edits             CatalogEditHistory[]

  @@index([familyId])
  @@index([isActive, isComplete])
  @@map("catalog_variants")
}

model CatalogAsset {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                String             @unique
  publicPath         String             @unique @map("public_path")
  sourceChecksum     String?            @map("source_checksum")
  derivedChecksum    String             @map("derived_checksum")
  provenance         Json
  geometry           Json
  masks              Json
  status             CatalogAssetStatus @default(DEVELOPMENT)
  rightsApproved     Boolean            @default(false) @map("rights_approved")
  productionApproved Boolean            @default(false) @map("production_approved")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  families           CatalogFamily[]
  variants           CatalogVariant[]

  @@map("catalog_assets")
}

model PriceVersion {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version                Int                  @unique
  currency               String               @default("RUB")
  rates                  Json
  checksum               String               @unique
  publishedAt            DateTime             @default(now()) @map("published_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  publications           CatalogPublication[]
  currentForPricingState PricingState?        @relation("CurrentPriceVersion")
  draftBases             PriceDraft[]         @relation("PriceDraftBaseVersion")
  leads                  Lead[]

  @@map("price_versions")
}

model PricingState {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey          String        @unique @default("pricing") @map("singleton_key")
  currentPriceVersionId String?       @unique @map("current_price_version_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  currentPriceVersion   PriceVersion? @relation("CurrentPriceVersion", fields: [currentPriceVersionId], references: [id], onDelete: Restrict)

  @@map("pricing_state")
}

model PriceDraft {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey       String       @unique @default("pricing") @map("singleton_key")
  basePriceVersionId String       @map("base_price_version_id") @db.Uuid
  revision           Int          @default(0)
  rates              Json
  updatedByUserId    String?      @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  basePriceVersion   PriceVersion @relation("PriceDraftBaseVersion", fields: [basePriceVersionId], references: [id], onDelete: Restrict)

  @@map("price_drafts")
}

model CatalogImportHistory {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceChecksum    String   @map("source_checksum")
  sourceMapChecksum String   @map("source_map_checksum")
  baseRevision      Int      @map("base_revision")
  resultingRevision Int      @map("resulting_revision")
  reconciliation    Json
  appliedAt         DateTime @default(now()) @map("applied_at")

  @@map("catalog_import_history")
}

model CatalogEditHistory {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  before    Json
  after     Json
  createdAt DateTime       @default(now()) @map("created_at")
  variant   CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("catalog_edit_history")
}

model CatalogPublication {
  id                 String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  catalogRevision    Int                        @map("catalog_revision")
  priceVersionId     String                     @map("price_version_id") @db.Uuid
  releaseId          String?                    @map("release_id")
  snapshot           Json
  pricingSnapshot    Json?                      @map("pricing_snapshot")
  checksum           String                     @unique
  status             CatalogPublicationStatus   @default(CANDIDATE)
  backupReceipt      Json?                      @map("backup_receipt")
  createdAt          DateTime                   @default(now()) @map("created_at")
  activatedAt        DateTime?                  @map("activated_at")
  publicVerifiedAt   DateTime?                  @map("public_verified_at")
  priceVersion       PriceVersion               @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  activeForState     CatalogState?              @relation("ActiveCatalogPublication")
  attemptsAsPrevious CatalogActivationAttempt[] @relation("PreviousPublication")
  attemptsAsNext     CatalogActivationAttempt[] @relation("NextPublication")
  leads              Lead[]

  @@index([status])
  @@map("catalog_publications")
}

model CatalogActivationAttempt {
  id                    String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  previousPublicationId String?                 @map("previous_publication_id") @db.Uuid
  nextPublicationId     String                  @map("next_publication_id") @db.Uuid
  previousReleasePath   String?                 @map("previous_release_path")
  nextReleasePath       String                  @map("next_release_path")
  status                ActivationAttemptStatus @default(PREPARED)
  recoveryDecision      String?                 @map("recovery_decision")
  error                 String?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  previousPublication   CatalogPublication?     @relation("PreviousPublication", fields: [previousPublicationId], references: [id], onDelete: Restrict)
  nextPublication       CatalogPublication      @relation("NextPublication", fields: [nextPublicationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("catalog_activation_attempts")
}

model AuthSession {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  refreshTokenFamilyHash   String?   @unique(map: "auth_sessions_refresh_token_family_hash_key") @map("refresh_token_family_hash")
  previousRefreshTokenHash String?   @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime? @map("refresh_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  recoverySmokeOperationId String?   @unique(map: "auth_sessions_recovery_smoke_operation_id_key") @map("recovery_smoke_operation_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model LeadPolicyVersion {
  id                        String                            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  version                   Int                               @unique
  privacyNoticeText         String                            @map("privacy_notice_text")
  privacyNoticeChecksum     String                            @map("privacy_notice_checksum")
  consentText               String                            @map("consent_text")
  consentChecksum           String                            @map("consent_checksum")
  policyBundleChecksum      String                            @unique @map("policy_bundle_checksum")
  operatorIdentity          Json                              @map("operator_identity")
  retentionDays             Int                               @map("retention_days")
  recoveryWindowDays        Int                               @map("recovery_window_days")
  deliveryMode              LeadPolicyDeliveryMode            @map("delivery_mode")
  deliveryConfigVersion     Int?                              @map("delivery_config_version")
  deliveryDestinationDigest String?                           @map("delivery_destination_digest")
  createdAt                 DateTime                          @default(now()) @map("created_at")
  activatedAt               DateTime?                         @map("activated_at")
  activeForStates           LeadPolicyState[]                 @relation("ActiveLeadPolicy")
  transitionOperations      LeadPolicyTransitionOperation[]
  withdrawal                LeadPolicyCandidateWithdrawal?
  attestations              LeadPolicyProtectionAttestation[]
  leads                     Lead[]

  @@map("lead_policy_versions")
}

model LeadPolicyCandidateWithdrawal {
  id                         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  policyVersionId            String            @unique @map("policy_version_id") @db.Uuid
  operationId                String            @unique @map("operation_id") @db.Uuid
  requestDigest              String            @map("request_digest")
  expectedPolicyRevision     Int               @map("expected_policy_revision")
  expectedTransitionRevision Int               @map("expected_transition_revision")
  reason                     String
  actorUserId                String?           @map("actor_user_id") @db.Uuid
  storedResult               Json              @map("stored_result")
  epochSequence              BigInt            @map("epoch_sequence")
  epochHash                  String            @map("epoch_hash")
  createdAt                  DateTime          @default(now()) @map("created_at")
  policyVersion              LeadPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  actor                      User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("lead_policy_candidate_withdrawals")
}

model LeadPolicyState {
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey          String             @unique @default("lead-policy") @map("singleton_key")
  activePolicyVersionId String?            @unique @map("active_policy_version_id") @db.Uuid
  revision              Int                @default(0)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  activePolicyVersion   LeadPolicyVersion? @relation("ActiveLeadPolicy", fields: [activePolicyVersionId], references: [id], onDelete: Restrict)

  @@map("lead_policy_state")
}

model LeadPolicyTransitionState {
  id                     String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singletonKey           String                         @unique @default("lead-policy-transition") @map("singleton_key")
  currentOperationId     String?                        @unique @map("current_operation_id") @db.Uuid
  terminalCommandId      String?                        @unique @map("terminal_command_id") @db.Uuid
  revision               Int                            @default(0)
  phase                  LeadPolicyTransitionPhase      @default(IDLE)
  effectiveRecoveryCapAt DateTime?                      @map("effective_recovery_cap_at")
  telegramDecision       String?                        @map("telegram_decision")
  captureBlock           Boolean                        @default(false) @map("capture_block")
  irreversible           Boolean                        @default(false)
  forwardOnly            Boolean                        @default(false) @map("forward_only")
  terminalDirection      LeadPolicyTerminalDirection?   @map("terminal_direction")
  createdAt              DateTime                       @default(now()) @map("created_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")
  currentOperation       LeadPolicyTransitionOperation? @relation("CurrentLeadPolicyTransition", fields: [currentOperationId], references: [id], onDelete: Restrict)
  terminalCommand        LeadPolicyTransitionCommand?   @relation("TerminalLeadPolicyCommand", fields: [terminalCommandId], references: [id], onDelete: Restrict)

  @@map("lead_policy_transition_state")
}

model LeadPolicyTransitionOperation {
  id                         String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operationId                String                        @unique @map("operation_id") @db.Uuid
  candidatePolicyVersionId   String                        @map("candidate_policy_version_id") @db.Uuid
  candidateBundleChecksum    String                        @map("candidate_bundle_checksum")
  startingPolicyRevision     Int                           @map("starting_policy_revision")
  startingTransitionRevision Int                           @map("starting_transition_revision")
  startingProtectionRevision Int                           @map("starting_protection_revision")
  phase                      LeadPolicyTransitionPhase     @default(PREPARED)
  telegramDecision           String                        @map("telegram_decision")
  retentionDecision          String                        @map("retention_decision")
  terminalOutcome            String?                       @map("terminal_outcome")
  startedAt                  DateTime                      @default(now()) @map("started_at")
  completedAt                DateTime?                     @map("completed_at")
  candidatePolicyVersion     LeadPolicyVersion             @relation(fields: [candidatePolicyVersionId], references: [id], onDelete: Restrict)
  commands                   LeadPolicyTransitionCommand[]
  currentForState            LeadPolicyTransitionState?    @relation("CurrentLeadPolicyTransition")

  @@map("lead_policy_transition_operations")
}

model LeadPolicyTransitionCommand {
  id                         String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  commandOperationId         String                        @unique @map("command_operation_id") @db.Uuid
  transitionOperationId      String                        @map("transition_operation_id") @db.Uuid
  kind                       LeadPolicyCommandKind
  requestDigest              String                        @map("request_digest")
  expectedPolicyRevision     Int                           @map("expected_policy_revision")
  expectedTransitionRevision Int                           @map("expected_transition_revision")
  expectedProtectionRevision Int                           @map("expected_protection_revision")
  expectedPhase              LeadPolicyTransitionPhase     @map("expected_phase")
  preAckFenceRevision        Int?                          @map("pre_ack_fence_revision")
  preAckDirection            LeadPolicyTerminalDirection?  @map("pre_ack_direction")
  epochSequence              BigInt?                       @map("epoch_sequence")
  epochHash                  String?                       @map("epoch_hash")
  checkpointSequence         BigInt?                       @map("checkpoint_sequence")
  storedPhase                String                        @map("stored_phase")
  storedResult               Json?                         @map("stored_result")
  createdAt                  DateTime                      @default(now()) @map("created_at")
  completedAt                DateTime?                     @map("completed_at")
  transitionOperation        LeadPolicyTransitionOperation @relation(fields: [transitionOperationId], references: [id], onDelete: Restrict)
  terminalForState           LeadPolicyTransitionState?    @relation("TerminalLeadPolicyCommand")

  @@index([transitionOperationId])
  @@map("lead_policy_transition_commands")
}

model BackupSnapshotGeneration {
  id                     String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exportedSnapshotId     String           @unique @map("exported_snapshot_id")
  releaseId              String           @map("release_id")
  dependencySetChecksum  String           @map("dependency_set_checksum")
  manifestSchemaVersion  Int              @map("manifest_schema_version")
  recoveryBundleChecksum String           @map("recovery_bundle_checksum")
  createdAt              DateTime         @default(now()) @map("created_at")
  completedAt            DateTime?        @map("completed_at")
  artifacts              BackupArtifact[]

  @@map("backup_snapshot_generations")
}

/// Phase-dependent proof requirements are PostgreSQL CHECK constraints in the
/// Stage 4A migration because Prisma 7 PSL cannot express conditional checks.
model BackupArtifact {
  id                         String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  snapshotGenerationId       String                   @map("snapshot_generation_id") @db.Uuid
  scope                      BackupScope
  schemaVersion              Int                      @map("schema_version")
  versionInventory           Json                     @map("version_inventory")
  versionInventoryChecksum   String                   @map("version_inventory_checksum")
  recoveryCapAt              DateTime?                @map("recovery_cap_at")
  encryptedObjectInventory   Json                     @map("encrypted_object_inventory")
  capacityInventory          Json?                    @map("capacity_inventory")
  capacityInventoryChecksum  String?                  @map("capacity_inventory_checksum")
  lifecycleReceipt           Json?                    @map("lifecycle_receipt")
  intendedProtectionRevision Int?                     @map("intended_protection_revision")
  attestationChecksum        String?                  @map("attestation_checksum")
  scopeHeadSequence          BigInt?                  @map("scope_head_sequence")
  scopeHeadHash              String?                  @map("scope_head_hash")
  state                      BackupArtifactState      @default(PREPARED)
  lifecycleRevision          Int                      @default(0) @map("lifecycle_revision")
  lifecycleRecordChecksum    String?                  @map("lifecycle_record_checksum")
  purgeReceiptChecksum       String?                  @map("purge_receipt_checksum")
  requiredCoreArtifactId     String?                  @map("required_core_artifact_id") @db.Uuid
  reconciliationError        String?                  @map("reconciliation_error")
